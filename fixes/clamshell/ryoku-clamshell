#!/usr/bin/env bash
#
# Ryoku's ryoku-clamshell with one policy change: on AC the laptop stays awake
# with the lid shut whether or not an external display is detected.
#
# Stock policy wants AC *and* a "connected" external connector; otherwise every
# close path (the lid bind, `lid sync` on each Hyprland config reload, and the
# daemon's udev watch) runs the lock-and-suspend transaction. Two things break
# that on this laptop:
#   - headless use over VNC re-locked every ~2s after unlocking (fix 2), and
#   - the BenQ drops its HDMI hot-plug line when it sleeps with no signal, or
#     switches input to the MacBook. HDMI-A-1 then reads "disconnected", and the
#     daemon suspended a docked, lid-shut laptop, making it unreachable over
#     SSH and VNC (fix 18, 2026-11-09 15:25).
# On battery, or when AC is unplugged with the lid shut, it still securely
# locks and suspends.
#
# Installed OUTSIDE ~/.local/bin on purpose: `ryoku doctor` (run by
# `ryoku update`) deletes any ~/.local/bin file that shadows a packaged
# command, which silently removed the first install of this wrapper. See
# fixes/clamshell/install.sh and fixes/README.md (fix 18).

# The shipped script only dispatches when executed, not when sourced.
source /usr/bin/ryoku-clamshell

# Child lid processes re-exec this wrapper, not the stock script.
CLAMSHELL_BIN="$(readlink -f -- "${BASH_SOURCE[0]}")"
export RYOKU_CLAMSHELL_BIN="$CLAMSHELL_BIN"

clamshell_wanted() { on_ac; }

# Hand the panel off only when there is a display to hand it to. Shutting off
# eDP-1 with nothing else connected leaves Hyprland with zero outputs: wayvnc
# loses the output it captures and exits, apps lose their surfaces' output, and
# reopening re-adds the panel at an autoscaled (wrong) scale.
eval "stock_$(declare -f disable_internal_panels)"
disable_internal_panels() { external_connected || return 0; stock_disable_internal_panels; }

cmd="${1:-daemon}"
case "$cmd" in
  daemon|start)
    log "AC-awake policy active (lid shut on AC never suspends; wrapper $CLAMSHELL_BIN)"
    run_daemon
    ;;
  stop)         stop_daemon ;;
  session-active) shift; cmd_session_active "$@" ;;
  policy)       shift; cmd_policy "$@" ;;
  lid)          shift; cmd_lid "$@" ;;
  status)       cmd_status; echo "policy=ac-awake" ;;
  is-laptop)    hw_laptop ;;
  -h|--help|help) usage ;;
  *)
    log "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
